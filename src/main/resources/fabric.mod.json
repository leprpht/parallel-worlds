{
  "schemaVersion": 1,
  "id": "parallelworlds",
  "version": "${version}",
  "name": "Parallel Worlds",
  "description": "Explore alternate world-generation variants in the existing world.",
  "authors": [
    "leprpht"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.leprpht.parallelworlds.ParallelWorlds"
      }
    ]
  },
  "mixins": [
    "parallelworlds.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-language-kotlin": ">=${fabric_language_kotlin_version}"
  }
}