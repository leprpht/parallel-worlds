#!/usr/bin/env bash

set -e

if [ -x ".venv/bin/black" ]; then
    BLACK=".venv/bin/black"
else
    echo "Error: Python virtual environment is not configured."
    echo "Run setup.sh first."
    exit 1
fi

echo "Running Python formatter..."
"$BLACK" scripts

echo "Running Kotlin formatter..."
./gradlew spotlessApply

if ! git diff --quiet; then
    echo
    echo "The formatter changed files."
    echo "The formatted files have been staged automatically."

    git diff --name-only --diff-filter=ACM | while IFS= read -r file; do
        git add -- "$file"
    done
fi

echo "Running Python formatting check..."
"$BLACK" --check scripts

echo "Running Kotlin formatting check..."
./gradlew spotlessCheck
