#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
validator="$ROOT_DIR/scripts/validate-release.sh"

[[ -x "$validator" ]] || {
    echo "Release validation failed: $validator is not executable." >&2
    exit 1
}

# Keep ordinary branch pushes from bypassing changelog validation.
"$validator"

tag_found=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_ref" == refs/tags/* ]] || continue

    # Deleting a remote tag is not a release operation.
    [[ "$local_sha" =~ ^0+$ ]] && continue

    tag_found=1
    tag="${local_ref#refs/tags/}"
    [[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || {
        echo "Release validation failed: tag '$tag' must match vMAJOR.MINOR.PATCH." >&2
        exit 1
    }

    version="${tag#v}"
    "$validator" "$version"
done

if [[ "$tag_found" -eq 0 ]]; then
    echo "Pre-push checks passed (no release tag is being pushed)."
else
    echo "Pre-push release checks passed."
fi
